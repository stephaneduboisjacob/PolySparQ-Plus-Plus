# Minimal local-development configuration for PolySparQ++.
# Copy this file to config/polypulse.toml and keep it in PAPER mode.
# The runtime config is ignored by Git.

[runtime]
mode = "paper"
log_level = "info"
journal_dir = "./journal"

[postgres]
# The database and schema identifiers retain their historical names.
conninfo = "postgresql:///vantagepulse"
read_replica = ""

[llm]
# The advisor is optional and disabled until you configure your own endpoint.
enabled = false
url = ""
model = ""
api_key_file = ""

[wallet]
# No wallet or trading credentials are needed for paper mode.
credentials_file = ""
private_key_file = ""
api_key = ""
api_secret = ""
api_passphrase = ""
starting_balance_usd = 0.0

[strategy.hot]
entry_order_mode = "maker"
# PAPER maker quotes stay open until a strategy/operator/market cancellation.
maker_max_age_ms = 0
# Coinbase-only confluence replay candidate; strictly PAPER-only when enabled.
coinbase_confluence_paper_enabled = false
coinbase_confluence_rule = "strike_window" # strike_window, window_move (5m), strike_momentum (15m), strike_window_momentum (5m)
coinbase_confluence_horizon_s = 0 # 0 = 5m and 15m; otherwise 300 or 900
coinbase_confluence_min_elapsed_pct = 20 # first eligible checkpoint: 20, 40, 60, or 80
coinbase_confluence_order_usd = 4.65 # gross, leaves room for taker fees under $5
coinbase_confluence_maker_enabled = false # separate PAPER-only fixed-share maker path
coinbase_confluence_order_shares = 20.0 # exact requested shares when maker mode is enabled
coinbase_confluence_maker_offset_ticks = 1 # post this many ticks below the observed ask
coinbase_confluence_maker_max_age_ms = 5500 # cancel if no qualifying public print arrives
coinbase_confluence_max_price = 0.90
coinbase_confluence_min_move_bps = 10.0
coinbase_confluence_min_momentum_10s_bps = 0.25 # required by 15m and strike_window_momentum
coinbase_confluence_max_spread = 0.08
coinbase_confluence_max_observation_age_ms = 1500

[data_collection]
# Enable only the datasets you intend to store; high-frequency data can grow quickly.
oracle_ticks_enabled = false
binance_ticks_enabled = false
coinbase_ticks_enabled = false
window_events_enabled = false
features_enabled = false
book_snapshots_enabled = false
# Levels saved per side when snapshots are enabled: 0 keeps BBO/summary only; 20 keeps full depth.
book_snapshot_levels = 20
pm_trades_enabled = false

[spot_feeds]
# Read-only Kraken / Gemini / OKX spot BBO feeds. They are collected for
# Predictions chart research and do not enter strategy or execution logic.
enabled = true
kraken_ws_url = "ws://127.0.0.1:9105"
gemini_ws_url = "ws://127.0.0.1:9106"
okx_ws_url = "ws://127.0.0.1:9107"
