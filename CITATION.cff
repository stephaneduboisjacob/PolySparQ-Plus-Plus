    given-names: Stephane
    email: jacobstephane@outlook.com
license-url: https://polyformproject.org/licenses/noncommercial/1.0.0
repository-code: https://github.com/stephaneduboisjacob/polysparq-plus-plus
date-released: 2026-10-09
